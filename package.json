{
    "name": "cartes.gouv.fr-editeur-mes-cartes",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "predev": "react-dsfr update-icons",
        "build": "tsc -b && vite build",
        "generate-api": "orval",
        "prebuild": "react-dsfr update-icons",
        "check-types": "tsc -b",
        "lint": "eslint src/ --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint src/ --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
        "preview": "vite preview",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@eslint/compat": "^2.1.0",
        "oidc-spa": "^10.2.6",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@codegouvfr/react-dsfr": "^1.17.0",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-angular": "^21.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@commitlint/prompt-cli": "^21.2.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/js": "^9.39.4",
        "@faker-js/faker": "^10.5.0",
        "@fvilers/disable-react-devtools": "^1.3.0",
        "@mantine/hooks": "^9.4.1",
        "@mui/material": "^9.2.0",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/eslint-plugin-query": "^5.101.2",
        "@tanstack/query-async-storage-persister": "^5.101.2",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-query-devtools": "^5.101.2",
        "@tanstack/react-query-persist-client": "^5.101.2",
        "@types/babel__core": "^7.20.5",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@unhead/react": "^3.0.0-beta.9",
        "@vitejs/plugin-react": "^6.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "date-fns-tz": "^3.2.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.0",
        "eslint-plugin-tss-unused-classes": "^1.0.4",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "i18nifty": "^4.0.6",
        "jiti": "^2.7.0",
        "lint-staged": "^17.3.0",
        "msw": "^2.15.0",
        "orval": "^8.0.0",
        "prettier": "3.9.6",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.2",
        "sass-embedded": "^1.100.0",
        "tss-react": "^4.9.21",
        "type-route": "^1.1.0",
        "typescript": "~6.0.2",
        "typescript-7": "npm:typescript@7.0.2",
        "typescript-eslint": "^8.62.1",
        "uuid": "^14.0.1",
        "vite": "^8.1.1"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
        "*.{js,ts,jsx,tsx}": "eslint src/ --report-unused-disable-directives --max-warnings 0 --no-warn-ignored --fix"
    },
    "engines": {
        "node": ">=26.0.0 <27.0.0",
        "npm": ">=12.0.0"
    }
}
